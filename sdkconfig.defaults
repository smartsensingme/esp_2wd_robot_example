CONFIG_IDF_TARGET="esp32c3"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_MT6701_THREAD_SAFE=n
CONFIG_ESP_RT_DIAGNOSTICS_ENABLE=y
CONFIG_ESP_RT_DIAGNOSTICS_DETAILED_TIMING=y

CONFIG_ROBOT_CALIBRATION_GPIO=5
CONFIG_ROBOT_CALIBRATION_DEBOUNCE_MS=50
CONFIG_ROBOT_CALIBRATION_LED_GPIO=-1
CONFIG_ROBOT_CALIBRATION_LED_ACTIVE_LEVEL=1
